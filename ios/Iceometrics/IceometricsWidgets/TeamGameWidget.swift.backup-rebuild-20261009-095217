import SwiftUI
import WidgetKit

struct TeamGameEntry: TimelineEntry {
    let date: Date
}

struct TeamGameProvider: TimelineProvider {
    func placeholder(
        in context: Context
    ) -> TeamGameEntry {
        TeamGameEntry(date: Date())
    }

    func getSnapshot(
        in context: Context,
        completion: @escaping (TeamGameEntry) -> Void
    ) {
        completion(
            TeamGameEntry(date: Date())
        )
    }

    func getTimeline(
        in context: Context,
        completion: @escaping (Timeline<TeamGameEntry>) -> Void
    ) {
        completion(
            Timeline(
                entries: [
                    TeamGameEntry(date: Date())
                ],
                policy: .never
            )
        )
    }
}

struct TeamGameWidgetView: View {
    let entry: TeamGameEntry

    var body: some View {
        ZStack {
            LinearGradient(
                colors: [
                    Color.blue,
                    Color.red
                ],
                startPoint: .leading,
                endPoint: .trailing
            )

            VStack(spacing: 8) {
                Text("TEAM GAME")
                    .font(.caption.bold())

                Text("TEST")
                    .font(
                        .system(
                            size: 30,
                            weight: .black,
                            design: .rounded
                        )
                    )

                Text("Widget is alive")
                    .font(.caption2)
            }
            .foregroundStyle(.white)
        }
        .containerBackground(
            Color.black,
            for: .widget
        )
    }
}

struct TeamGameWidget: Widget {
    let kind = "IceometricsTeamGameIsolation"

    var body: some WidgetConfiguration {
        StaticConfiguration(
            kind: kind,
            provider: TeamGameProvider()
        ) { entry in
            TeamGameWidgetView(
                entry: entry
            )
        }
        .configurationDisplayName("Team Game Test")
        .description("Team Game widget diagnostic.")
        .supportedFamilies([
            .systemSmall
        ])
    }
}
